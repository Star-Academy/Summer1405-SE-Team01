  "studentNumber": "40110003",
  "firstName": "ThisNameIsTooLongForTheDB",
  "lastName": "Test",
  "isMale": true,
  "grade": 16.0,
  "dateOfBirth": "2005-01-01T00:00:00",
  "leftUnitsCount": 10
}

